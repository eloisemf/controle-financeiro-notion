# ==============================================================================
# CONTROLE FINANCEIRO - VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com suas credenciais:
# cp .env.example .env
# ==============================================================================

# 1. Credencial da Integração do Notion (Obrigatório)
# Crie uma integração interna em: https://www.notion.so/my-integrations
# Não esqueça de convidar a integração para a sua página principal de Finanças no Notion!
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Google Gemini API Key (Opcional - necessário apenas para extrator multimodal via prints de faturas)
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# 3. Nome Completo do Titular das Contas (Opcional)
# Usado para classificar transferências Pix entre suas próprias contas como "Movimentação Interna"
NOME_TITULAR=Seu Nome Completo

# 4. IDs das Databases e Páginas do Notion
# Podem ser extraídos da URL de cada database no Notion (32 caracteres hexadecimais sem hífens)
# ou descobertos via `python inspect_notion.py`
NOTION_TRANSACOES_DB_ID=
NOTION_MESES_DB_ID=
NOTION_CONTAS_DB_ID=
NOTION_CATEGORIAS_DB_ID=
NOTION_USO_DINHEIRO_DB_ID=
NOTION_GASTOS_FIXOS_DB_ID=
NOTION_PESSOAS_DB_ID=
NOTION_PARCELAS_DB_ID=
NOTION_MEUS_INVESTIMENTOS_DB_ID=
NOTION_APORTES_DB_ID=
NOTION_HISTORICO_SALDOS_DB_ID=
NOTION_PAGE_FINANCAS=
NOTION_PAGE_GASTOS_FIXOS=
